# ---------------------------------------------------------------------------
# Swarangan — environment
#
# Copy to `.env.local` and fill in. Nothing here is required for Phase 1 (the
# public site runs with no configuration at all); the Supabase and Resend keys
# arrive in Phase 2.
# ---------------------------------------------------------------------------

# Canonical origin. Drives sitemap.xml, robots.txt, canonical tags and OG URLs.
# Leave unset locally; set to https://www.swarangan.sg in production.
NEXT_PUBLIC_SITE_URL=

# --- Phase 2: Supabase -----------------------------------------------------
# From the Supabase dashboard: Project Settings -> API.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix this with NEXT_PUBLIC_ — it bypasses row-level
# security and must never reach the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 2: Resend (enquiry notifications) -------------------------------
# RESEND_API_KEY=
# ENQUIRY_NOTIFY_TO=info@swarangan.sg
# ENQUIRY_NOTIFY_FROM=Swarangan <enquiries@swarangan.sg>
