# ---------------------------------------------------------------------------
# Swarangan — environment variables
#
# Copy to `.env.local` for local development, and set the same names in Vercel
# (Project -> Settings -> Environment Variables) for production.
#
# The public site needs NONE of these to build or run. They switch on the admin
# panel and the keepalive. Step-by-step instructions are in SETUP.md.
# ---------------------------------------------------------------------------

# Canonical origin. Drives sitemap.xml, robots.txt, canonical tags and OG URLs.
NEXT_PUBLIC_SITE_URL=https://www.swarangan.sg

# --- Supabase (Project Settings -> API Keys) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_,
# never commit it, never paste it into client code.
SUPABASE_SECRET_KEY=

# Salts the stored login-throttle keys. Any long random string; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_THROTTLE_PEPPER=

# --- Keepalive --------------------------------------------------------------
# Shared by Vercel Cron and the GitHub Action. Generate the same way as above.
CRON_SECRET=

# --- Search engines (optional) ---------------------------------------------
# IndexNow key: lets `npm run indexnow` tell Bing and others the site changed.
# Any 32-character hex string; generate like the secrets above.
INDEXNOW_KEY=
